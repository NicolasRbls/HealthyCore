# Production Environment Example
# On the VPS, copy this file to .env (e.g., `cp .env.example.prod .env`)
# and replace the placeholder values with your actual production secrets.

# --- Database Connection ---
# The hostname must be the service name from docker-compose.prod.yml (in our case, "postgres")
DATABASE_URL="postgresql://YOUR_PROD_DB_USER:YOUR_PROD_DB_PASSWORD@postgres:5432/YOUR_PROD_DB_NAME?schema=public"

# --- PostgreSQL Credentials ---
# These must match the credentials used in DATABASE_URL
POSTGRES_USER=YOUR_PROD_DB_USER
POSTGRES_PASSWORD=YOUR_PROD_DB_PASSWORD
POSTGRES_DB=YOUR_PROD_DB_NAME

# --- JWT Secret ---
# Use a long, random, and secret string for security.
# You can generate one with: openssl rand -base64 32
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY
JWT_EXPIRES_IN=7d

# --- Admin User Seed ---
# These values are used to create the initial admin user when seeding the database.
ADMIN_PRENOM=Admin
ADMIN_NOM=User
ADMIN_SEXE=NS
ADMIN_DATE_DE_NAISSANCE=1990-01-01
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=UseAStrongPasswordHere

# --- Server Configuration ---
PORT=5000
API_URL=http://<YOUR_VPS_PUBLIC_IP>:5000/api
NODE_ENV=production

# --- Security ---
SALT_ROUNDS=10
CORS_ORIGIN=* # Or specify your frontend domain for better security
